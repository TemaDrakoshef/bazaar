LOG_LEVEL=INFO
ENVIRONMENT=dev

POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bazaar-catalog-db

# MinIO / S3 object storage for product media.
# S3_ENDPOINT_URL=http://localhost:9000  # use localhost when running outside Docker
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=miniopassword
S3_BUCKET_NAME=bazaar-media