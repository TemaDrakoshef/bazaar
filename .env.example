# ─────────────────────────────────────────────────────────────────────────────
# Root .env — used ONLY for Docker Compose *variable interpolation* of the
# infrastructure containers (postgres images, minio, grafana, otel, prometheus).
#
# Each application container (auth_service, catalog_service, seller_service,
# api_gateway) additionally loads its OWN `services/<name>/.env` via `env_file`
# — see the per-service `.env.example` files. Keep POSTGRES_* values here
# consistent with the DB names/credentials those service .env files expect.
#
# Usage: cp .env.example .env   (then adjust the secrets)
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared Postgres credentials for the per-service DB containers ─────────────
# auth_db / catalog_db / seller_db all reuse these; DB names differ per service
# via their own service .env. For a from-scratch local bring-up keep them equal.
POSTGRES_USER=bazaar
POSTGRES_PASSWORD=bazaar
POSTGRES_DB=bazaar

# ── MinIO (S3 object storage for product media) ──────────────────────────────
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=miniopassword

# ── OpenTelemetry Collector ──────────────────────────────────────────────────
DEPLOYMENT_ENVIRONMENT=local
CLUSTER_NAME=bazaar-local
OTEL_COLLECTOR_OTLP_GRPC_PORT=4317
OTEL_COLLECTOR_OTLP_HTTP_PORT=4318
OTEL_COLLECTOR_METRICS_PORT=8889

# ── Prometheus / Loki ────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
PROM_RETENTION=15d
LOKI_PORT=3100

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
GRAFANA_ROOT_URL=http://localhost:3000

# ── Frontend (Next.js standalone container) ──────────────────────────────────
# API base the built frontend will call from the browser. When the frontend runs
# in Docker but the gateway on the host, use host.docker.internal.
FRONTEND_API_URL=http://host.docker.internal:8000
